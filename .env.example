# Public site URL (no trailing slash). Used for canonical URLs, sitemap, RSS and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form -> webhook (for example an n8n "Webhook" node).
# Leave empty in development: submissions are logged to the server console instead.
CONTACT_WEBHOOK_URL=
# Shared secret used to sign the request body with HMAC-SHA256 (hex).
# The signature is sent in the X-Signature header as "sha256=<hex>" with X-Timestamp.
CONTACT_WEBHOOK_SECRET=

# Optional: contact details shown in the footer and Organization JSON-LD.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
