{
  "name": "nextjs-agency-starter",
  "version": "1.0.0",
  "description": "An SEO-first, bilingual (English/Bangla) agency and freelancer website starter built with Next.js App Router, TypeScript and Tailwind CSS.",
  "private": true,
  "license": "MIT",
  "author": "Saizul Amin <https://saizul.com>",
  "homepage": "https://saizul.com",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "clean": "rm -rf .next out coverage test-results playwright-report tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "16.4.5",
    "next-mdx-remote": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
